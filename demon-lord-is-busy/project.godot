; Engine configuration file.

config_version=5

[application]

config/name="마왕님은 바쁘다"
run/main_scene="res://src/scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[rendering]

environment/defaults/default_clear_color=Color(0.03, 0.025, 0.05, 1)

renderer/rendering_method="forward_plus"
; HDR 2D lets colors above 1.0 bloom through the WorldEnvironment glow (Game._ready)
viewport/hdr_2d=true
; ponytail: pixel art needs nearest filtering, otherwise 16x16 sprites blur
textures/canvas_textures/default_texture_filter=0
; Apple Silicon (arm64/universal) macOS export requires ETC2/ASTC
textures/vram_compression/import_etc2_astc=true
